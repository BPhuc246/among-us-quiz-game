# Copy file này thành backend/.env rồi điền key. KHÔNG commit file .env.

# --- AI chuẩn hóa câu hỏi (route POST /normalize) ---
# Gemini (lấy key miễn phí tại https://aistudio.google.com/apikey)
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# OPENAI_MODEL=gemini-3.5-flash-lite
# Model dự phòng khi model chính quá tải (503/429), cách nhau bởi dấu phẩy:
# OPENAI_FALLBACK_MODELS=gemini-flash-lite-latest,gemini-3.1-flash-lite,gemini-3.8-flash

# Muốn dùng OpenAI thay Gemini: xoá OPENAI_BASE_URL, dùng key sk-... và:
# OPENAI_MODEL=gpt-5-nano
# OPENAI_REASONING_EFFORT=minimal

# --- Server ---
# PORT=3000
# ALLOWED_ORIGIN=http://localhost:8080,https://your-frontend.example.com
